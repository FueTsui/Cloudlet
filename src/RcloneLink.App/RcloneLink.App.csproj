<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/Cloudlet/icon.ico</ApplicationIcon>
    <AssemblyName>Cloudlet</AssemblyName>
    <RootNamespace>RcloneLink.App</RootNamespace>
    <Product>Cloudlet</Product>
    <Company>FueTsui</Company>
    <Description>Cloudlet Windows 11 云存储与磁盘挂载</Description>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <EnableMsixTooling>false</EnableMsixTooling>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <ProjectReference Include="../RcloneLink.Core/RcloneLink.Core.csproj" />
    <Content Include="../../assets/Cloudlet/icon.ico" Link="Assets/icon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../assets/Cloudlet/icon-black.ico" Link="Assets/icon-black.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../assets/Cloudlet/icon-white.ico" Link="Assets/icon-white.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../assets/Cloudlet/icon-black.png" Link="Assets/icon-black.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../assets/Cloudlet/icon-white.png" Link="Assets/icon-white.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../rclone.exe" Link="rclone.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../winfsp-2.1.25156.msi" Link="winfsp-2.1.25156.msi" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="IncludeXamlResources" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <_XamlResource Include="$(TargetDir)**/*.xbf" Exclude="$(TargetDir)publish/**/*" />
      <_XamlResource Include="$(TargetDir)$(TargetName).pri" />
      <ResolvedFileToPublish Include="@(_XamlResource)">
        <RelativePath>%(_XamlResource.RecursiveDir)%(_XamlResource.Filename)%(_XamlResource.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
    <Error Condition="!Exists('$(TargetDir)App.xbf')" Text="Missing WinUI App.xbf" />
    <Error Condition="!Exists('$(TargetDir)$(TargetName).pri')" Text="Missing WinUI resource index" />
  </Target>
</Project>
